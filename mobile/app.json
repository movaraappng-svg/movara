{
  "expo": {
    "name": "MoVara",
    "slug": "movara",
    "scheme": "movara",
    "version": "1.0.0",
    "android": {
      "package": "com.movaraappng.movara",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.movaraappng.movara"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MoVara to use your location to set your ride pickup."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "updates"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1b1402d5-6db4-48b8-a3bd-612b9fa4d27d"
      }
    },
    "owner": "movavaraapp"
  }
}
