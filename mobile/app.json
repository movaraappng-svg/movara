{
  "expo": {
    "name": "MoVara",
    "slug": "movara",
    "icon": "./assets/branding/movara-icon.png",
    "scheme": "movara",
    "version": "1.0.1",
    "android": {
      "package": "com.movaraappng.movara",
      "icon": "./assets/branding/movara-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/movara-icon.png",
        "backgroundColor": "#081C3A"
      },
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.movaraappng.movara",
      "icon": "./assets/branding/movara-icon.png"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "./plugins/with-android-workmanager-keep-rules",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MoVara to use your location to set your ride pickup."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "updates"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/movara-logo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#081C3A"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1b1402d5-6db4-48b8-a3bd-612b9fa4d27d"
      }
    },
    "owner": "movavaraapp"
  }
}
